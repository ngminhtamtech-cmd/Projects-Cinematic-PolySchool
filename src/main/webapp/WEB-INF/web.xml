    <!-- D1: bao ve TOAN BO ung dung khoi CSRF, khong con gioi han o /api/v1/*.
         Nhan header X-CSRF-Token (REST/AJAX) lan tham so form _csrf (JSP).
         Dat cuoi chuoi filter de chay sau CharacterEncodingFilter (getParameter phai giai ma UTF-8
         dung) va sau AuthFilter (request chua dang nhap bi day ve /login truoc, khong ton cong kiem token). -->
    <filter>
        <filter-name>CsrfFilter</filter-name>
        <filter-class>com.mycompany.website.ban.ve.xem.phim.api.CsrfFilter</filter-class>
    </filter>
    <filter-mapping>
