    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <session-config>
        <session-timeout>
            30
        </session-timeout>
        <!-- D13: JSESSIONID khong cho JS doc. SameSite dat o META-INF/context.xml
             (Servlet 4.0 chua co API SameSite). <secure> de false vi moi truong dev chay HTTP. -->
        <cookie-config>
            <http-only>true</http-only>
            <secure>false</secure>
        </cookie-config>
        <!-- Cam ;jsessionid= tren URL: session id lot vao Referer/log la mot duong chiem phien. -->
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <listener>
        <listener-class>com.mycompany.website.ban.ve.xem.phim.config.AppContextListener</listener-class>
    </listener>

    <!-- Dat dau chuoi de header con nguyen ca tren duong tra loi loi (403/404/500). -->
    <filter>
        <filter-name>SecurityHeaderFilter</filter-name>
        <filter-class>com.mycompany.website.ban.ve.xem.phim.filter.SecurityHeaderFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>SecurityHeaderFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- BUG-09: gan IP/User-Agent vao RequestContext cho ca chuoi xu ly, xoa trong finally.
         Dat gan dau chuoi de moi thao tac quan tri phia sau deu ghi duoc "tu dau" vao audit. -->
    <filter>
        <filter-name>RequestContextFilter</filter-name>
        <filter-class>com.mycompany.website.ban.ve.xem.phim.filter.RequestContextFilter</filter-class>
    </filter>
    <filter-mapping>
