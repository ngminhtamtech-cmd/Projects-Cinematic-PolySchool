' =============================================================================
'  15. Sequence Diagram: Quản lý phòng chiếu
'
'  Nguồn đối chiếu (đọc trực tiếp mã nguồn, không suy đoán):
'    web.xml                                     -> /admin/rooms, /admin/rooms/*
'    filter/AuthFilter.java:147                  -> tiền tố /admin yêu cầu vai >= manager
'    controller/admin/ManagerPortalServlet:819   -> handleRoomPost: delete | deactivate |
'                                                   activate | preview | save_seats | lưu
'    service/AdminService.java:1624              -> saveRoom(room, rowCount, seatsPerRow,
'                                                   vipRowsCsv, regenerateLayout, actor)
'    service/AdminService.java:1572              -> previewRoomSeats(roomId, requested, actor)
'    service/AdminService.java:1537              -> saveCustomRoomSeats(roomId, seats, actor)
'    service/AdminService.java:1771/1789         -> deleteRoom(roomId, actor[, forceHardDelete])
'    service/AdminService.java:2179/2193         -> activateRoom / deactivateRoom
'    util/ScopeUtil.java                         -> assertCinemaScope (chỉ chặn manager)
'    service/SeatLayoutPreview.java              -> record trả về cho nhánh preview
'    database/fix32_seat_layout_versions.sql     -> Seats.LayoutVersion / IsActive / RetiredAt
'    database/fix40_room_deleted_status.sql      -> CK_Rooms_Status thêm giá trị 'deleted'
'
'  ĐIỂM DỄ VẼ SAI ĐÃ KIỂM CHỨNG:
'    1. saveRoom kiểm phạm vi HAI lần: assertCinemaScope(actor, room.cinemaId) cho cụm rạp
'       đích, rồi assertRoomScope(actor, room.id) khi đang SỬA phòng đã có. Thiếu vế thứ
'       hai là lỗ IDOR: chuyển phòng của rạp khác sang cụm rạp của chính mình.
'    2. Nhánh "preview" KHÔNG ghi CSDL — chỉ tính chênh lệch và trả JSON.
'    3. Xoá phòng ghi Rooms.Status='deleted'. Giá trị này chỉ hợp lệ TỪ fix40; trước đó
'       CK_Rooms_Status chỉ cho 'active'/'inactive' nên nhánh xoá mềm chưa bao giờ chạy được.
'
'  Render:
'    java -jar tools/plantuml/plantuml.jar -tsvg -charset UTF-8 -o ../svg <file>
'    java -jar tools/plantuml/plantuml.jar -tpng -charset UTF-8 -o ../png --skinparam dpi=450 <file>
' =============================================================================
@startuml 15. Sequence Diagram – Quản lý phòng chiếu
title 15. SEQUENCE DIAGRAM – QUẢN LÝ PHÒNG CHIẾU\n<size:12>Quản lý rạp → ManagerPortalServlet → AdminService → ScopeUtil → SQL Server</size>
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam ArrowThickness 1
skinparam sequenceMessageAlign left
skinparam maxMessageSize 260

actor "Quản lý rạp" as Actor
participant "room-form.jsp\nroom-seats.jsp" as JSP <<view>>
participant "CsrfFilter\n+ AuthFilter" as Filters <<filter>>
participant "ManagerPortalServlet" as Ctrl <<controller>>
participant "AdminService" as Svc <<service>>
participant "ScopeUtil" as Scope <<util>>
database "SQL Server\nCineBookDB" as DB

== 1. Qua chuỗi filter ==

Actor -> JSP : mở /admin/rooms,\nnhập thông tin phòng chiếu
activate JSP
JSP -> Filters : POST /admin/rooms (form + _csrf)
deactivate JSP
activate Filters
Filters -> Filters : xác thực token CSRF\nrequiredRole("/admin") = "manager"
alt token sai hoặc vai < manager
  Filters --> JSP : 403 FORBIDDEN
else hợp lệ
  Filters -> Ctrl : doPost(request, response)
  deactivate Filters
  activate Ctrl
end

Ctrl -> Ctrl : action = param("action")

== 2. TẠO / SỬA phòng chiếu (action rỗng) ==

Ctrl -> Svc : saveRoom(room, rowCount, seatsPerRow,\nvipRowsCsv, regenerateLayout, actor)
activate Svc

Svc -> Scope : assertCinemaScope(actor, room.cinemaId)
activate Scope
alt manager và cinemaId ≠ Users.CinemaId
  Scope --> JSP : 403 "Bạn không có quyền truy cập\ndữ liệu của cụm rạp này."
end
deactivate Scope

opt room.getId() > 0 (đang sửa phòng đã có)
  Svc -> Svc : assertRoomScope(actor, room.id)
  note right of Svc
    Kiểm phạm vi HAI lần là có chủ ý: vế đầu chặn
    cụm rạp ĐÍCH, vế sau chặn cụm rạp NGUỒN. Thiếu
    vế sau, manager sửa được phòng của rạp khác
    bằng cách gán cinemaId về cụm rạp của mình.
  end note
end

Svc -> Svc : kiểm tên phòng không rỗng
Svc -> DB : BEGIN TRANSACTION
activate DB
alt tạo mới
  Svc -> DB : INSERT INTO Rooms (CinemaId, Name, RoomType,\nStatus='active')
else cập nhật
  Svc -> DB : UPDATE Rooms SET Name=?, RoomType=?,\nUpdatedAt=GETDATE() WHERE Id=?
end

opt regenerateLayout = true
  Svc -> DB : sinh lại sơ đồ ghế\nrowCount × seatsPerRow, hàng VIP theo vipRowsCsv\nINSERT INTO Seats (RoomId, RowLabel, SeatNumber,\n  SeatType, SeatKey, LayoutVersion)
  note right of DB
    UQ_Seats_Room_SeatKey chặn trùng mã ghế
    trong cùng phòng. CK_Seats_Type giới hạn
    SeatType ∈ (standard, vip, couple).
  end note
end

Svc -> DB : INSERT INTO AuditLogs
Svc -> DB : COMMIT
DB --> Svc : thành công
deactivate DB
Svc --> Ctrl : trả về
deactivate Svc
Ctrl --> JSP : redirect /admin/rooms\n"Đã lưu phòng chiếu"

== 3. Các nhánh thao tác khác trên cùng endpoint ==

alt action = "preview" — xem trước sơ đồ ghế tuỳ chỉnh

  Ctrl -> Ctrl : parseSeatJson(roomId, seatsJson)
  Ctrl -> Svc : previewRoomSeats(roomId, requestedSeats, actor)
  activate Svc
  Svc -> Scope : assertRoomScope(actor, roomId)
  Svc -> DB : SELECT sơ đồ ghế hiện tại\n+ ghế đang được suất chiếu tham chiếu
  activate DB
  DB --> Svc : danh sách ghế hiện có
  deactivate DB
  Svc -> Svc : tính chênh lệch:\naddedSeatKeys / removedSeatKeys /\nreferencedSeatKeys / nextLayoutVersion
  note right of Svc
    Nhánh này KHÔNG ghi CSDL — chỉ đọc và tính
    toán, trả JSON để giao diện cảnh báo trước
    khi người dùng bấm lưu thật.
  end note
  Svc --> Ctrl : SeatLayoutPreview
  deactivate Svc
  Ctrl --> JSP : 200 JSON {addedSeatKeys, removedSeatKeys,\nreferencedSeatKeys, nextLayoutVersion}

else action = "save_seats" — lưu sơ đồ ghế tuỳ chỉnh

  Ctrl -> Svc : saveCustomRoomSeats(roomId, seats, actor)
  activate Svc
  Svc -> Scope : assertRoomScope(actor, roomId)
  Svc -> DB : BEGIN TRANSACTION
  activate DB
  Svc -> DB : cập nhật Seats theo sơ đồ mới\n(LayoutVersion tăng, ghế bị bỏ đánh RetiredAt/IsActive=0)
  Svc -> DB : INSERT INTO AuditLogs
  Svc -> DB : COMMIT
  deactivate DB
  deactivate Svc
  Ctrl --> JSP : "Đã lưu sơ đồ ghế phòng chiếu (N ghế)."

else action = "deactivate" / "activate" — tạm ngưng / khôi phục

  Ctrl -> Svc : deactivateRoom(roomId, actor)\nhoặc activateRoom(roomId, actor)
  activate Svc
  Svc -> Scope : assertRoomScope(actor, roomId)
  Svc -> DB : UPDATE Rooms SET Status='inactive' | 'active'\nWHERE Id=?
  activate DB
  DB --> Svc : thành công
  deactivate DB
  deactivate Svc
  Ctrl --> JSP : "Đã tạm ngưng / khôi phục\nhoạt động phòng chiếu."

else action = "delete" — xoá phòng chiếu

  Ctrl -> Svc : deleteRoom(roomId, actor)
  activate Svc
  Svc -> Scope : assertRoomScope(actor, roomId)
  Svc -> DB : BEGIN TRANSACTION
  activate DB
  Svc -> DB : đếm suất chiếu / đơn đặt vé\nđang tham chiếu phòng này
  DB --> Svc : số bản ghi liên quan
  alt chưa có dữ liệu tham chiếu
    Svc -> DB : DELETE FROM Seats WHERE RoomId=?\nDELETE FROM Rooms WHERE Id=?
  else còn dữ liệu lịch sử
    Svc -> DB : UPDATE Rooms SET Status='deleted'\nWHERE Id=?
    note right of DB
      Giá trị 'deleted' CHỈ hợp lệ từ fix40.
      Trước đó CK_Rooms_Status chỉ cho phép
      'active'/'inactive', nên nhánh xoá mềm
      này chưa bao giờ chạy được — SQLException
      bị bắt và hiển thị nhầm thành lỗi dữ liệu.
    end note
  end
  Svc -> DB : INSERT INTO AuditLogs
  Svc -> DB : COMMIT
  deactivate DB
  deactivate Svc
  Ctrl --> JSP : "Đã cập nhật trạng thái /\nxoá phòng chiếu thành công."
end

deactivate Ctrl
JSP --> Actor : hiển thị danh sách phòng chiếu\n+ thông báo kết quả

legend bottom
  |= Ghi chú |
  | Toàn bộ 6 nhánh dùng CHUNG một endpoint POST /admin/rooms, phân biệt bằng tham số action. |
  | Mọi nhánh ghi đều kiểm phạm vi cụm rạp trước, nằm trong một transaction, và để lại dòng AuditLogs. |
  | Nhánh "preview" là nhánh ĐỌC duy nhất: không mở transaction, không ghi bảng nào. |
  | Khối catch trong transaction phải bắt CẢ SQLException LẪN RuntimeException; chỉ bắt RuntimeException |
  | từng làm deleteRoom mất sạch ghế vì không rollback. |
endlegend

@enduml
