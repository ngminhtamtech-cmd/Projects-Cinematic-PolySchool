Cinemas ||--o{ ApprovalRequests : "CinemaId → Id"
Users ||--o{ ApprovalRequests : "RequestedBy/ReviewedBy → Id"
ApprovalRequests ||--o| FilmRequestDetails : "RequestId → Id"
Films |o..o{ FilmRequestDetails : "ExistingFilmId → Id"
ApprovalRequests ||--o{ FilmRequestCategories : "RequestId → Id"
Categories ||--o{ FilmRequestCategories : "CategoryId → Id"
ApprovalRequests ||--o| RoomRequestDetails : "RequestId → Id"
ApprovalRequests ||--o{ RoomRequestSeats : "RequestId → Id"
Cinemas ||--o{ CinemaContents : "CinemaId → Id"
Users ||--o{ CinemaContents : "UpdatedByUserId → Id"
Cinemas |o..o{ AdminNotifications : "CinemaId → Id"
ApprovalRequests |o..o{ AdminNotifications : "ApprovalRequestId → Id"
Users ||--o{ Promotions : "CreatedByUserId → Id"
