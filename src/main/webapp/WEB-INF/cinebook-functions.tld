<?xml version="1.0" encoding="UTF-8"?>
<taglib xmlns="http://java.sun.com/xml/ns/javaee"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-jsptaglibrary_2_1.xsd"
        version="2.1">
    <tlib-version>1.0</tlib-version>
    <short-name>cbf</short-name>
    <uri>https://cinebook.local/functions</uri>
    <function>
        <name>assetUrl</name>
        <function-class>com.mycompany.website.ban.ve.xem.phim.util.AssetUrlHelper</function-class>
        <function-signature>
            java.lang.String withContext(java.lang.String, java.lang.String)
        </function-signature>
    </function>
    <function>
        <name>whole</name>
        <function-class>com.mycompany.website.ban.ve.xem.phim.util.DisplayFormat</function-class>
        <function-signature>
            java.lang.String whole(java.lang.Object)
        </function-signature>
    </function>
    <function>
        <name>decimal</name>
        <function-class>com.mycompany.website.ban.ve.xem.phim.util.DisplayFormat</function-class>
        <function-signature>
            java.lang.String decimal(java.lang.Object)
        </function-signature>
    </function>
</taglib>
