Users ||--o{ RefreshTokens : "UserId → Id (thiết kế; DB hiện không ép FK)"
Users ||--o{ PasswordResetTokens : "UserId → Id"
Users ||--o{ UserAppeals : "UserId → Id"
Orders |o..o{ UserAppeals : "OrderId → Id (kháng cáo hoàn tiền)"
Users ||--o{ UserAppeals : "ResolvedByUserId → Id"
@enduml


