  Type : NVARCHAR(30)
}

entity "RefreshTokens" as RefreshTokens {
  * Id : INT <<PK>>
  --
  UserId : INT <<FK*>>
  ' fix19 định nghĩa FK nhưng bảng đã tồn tại từ schema.sql (không FK) →
  ' constraint KHÔNG thực thi trong DB hiện hành, dù ý định thiết kế có FK
  FamilyId : UNIQUEIDENTIFIER
  TokenHash : CHAR(64) <<UQ>>
  ReplacedById : INT <<FK*>>
  RevokedAt : DATETIME2
}

entity "PasswordResetTokens" as PasswordResetTokens {
  * Id : INT <<PK>>
  --
  UserId : INT <<FK>>
  TokenHash : CHAR(64) <<UQ>>
