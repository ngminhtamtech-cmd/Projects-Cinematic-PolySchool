skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam linetype ortho

entity "Users" as Users {
  * Id : INT <<PK>>
}

entity "Orders" as Orders {
  * Id : INT <<PK>>
}

entity "Promotions" as Promotions {
