<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions" %>

<%
    String uri = request.getRequestURI();
    String ctx = request.getContextPath();
    String currentPath = uri.substring(ctx.length());
    String tabParam = request.getParameter("tab");
    String pageTitle = "Hệ thống";
    
    if ("custom".equals(tabParam)) {
        pageTitle = "Nội dung khác";
    } else if (currentPath != null) {
        if (currentPath.contains("/admin/dashboard")) pageTitle = "Tổng quan";
        else if (currentPath.contains("/admin/films")) pageTitle = "Quản lý Phim";
        else if (currentPath.contains("/admin/cinemas")) pageTitle = "Hệ thống Rạp";
        else if (currentPath.contains("/admin/rooms")) pageTitle = "Phòng chiếu";
        else if (currentPath.contains("/admin/showtimes")) pageTitle = "Lịch chiếu & Suất chiếu";
        else if (currentPath.contains("/admin/requests")) pageTitle = "Yêu cầu phê duyệt";
        else if (currentPath.contains("/admin/users")) pageTitle = "Quản lý Thành viên";
        else if (currentPath.contains("/admin/staff")) pageTitle = "Nhân viên quầy vé";
        else if (currentPath.contains("/admin/comments")) pageTitle = "Duyệt Bình luận";
        else if (currentPath.contains("/admin/promotions")) pageTitle = "Chương trình Khuyến mãi";
        else if (currentPath.contains("/admin/orders")) pageTitle = "Quản lý Đơn vé";
        else if (currentPath.contains("/admin/reports")) pageTitle = "Báo cáo Thống kê";
        else if (currentPath.contains("/system/dashboard")) pageTitle = "Tổng quan Hệ thống";
        else if (currentPath.contains("/system/config")) pageTitle = "Cấu hình Hệ thống";
        else if (currentPath.contains("/system/managers")) pageTitle = "Tài khoản Vận hành (Manager)";
        else if (currentPath.contains("/system/audit-logs")) pageTitle = "Nhật ký Hệ thống (Audit Logs)";
    }
    request.setAttribute("computedAdminPageTitle", pageTitle);
%>

<header class="topbar" id="adminMainContent"
        data-dashboard-url="${pageContext.request.contextPath}/admin/dashboard">
    <div class="topbar-left">
        <button type="button" class="nav-toggle-admin" id="adminMobileMenuButton"
                onclick="toggleAdminDrawer()" aria-label="Mở menu quản trị"
                aria-controls="adminSidebar" aria-expanded="false">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" aria-hidden="true" style="width:18px;height:18px;">
                <path d="M4 7h16M4 12h16M4 17h16"/>
            </svg>
        </button>
        <!-- Breadcrumbs -->
        <nav class="breadcrumbs" aria-label="Điều hướng trang">
            <a href="${pageContext.request.contextPath}/admin/dashboard">CineBook Admin</a>
            <span class="breadcrumbs-separator">/</span>
            <span class="breadcrumbs-current">${fn:escapeXml(computedAdminPageTitle)}</span>
        </nav>
    </div>
    
    <div class="topbar-right" style="display:flex;align-items:center;gap:8px;">
        <!-- Dynamic Quick Filter Search Bar -->
        <div class="topbar-search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14M16.5 16.5 21 21"/></svg>
            <input type="search" id="globalAdminSearchInput" placeholder="Lọc dữ liệu trong trang…"
                   oninput="performGlobalAdminSearch()" title="Lọc nhanh dữ liệu đang hiển thị">
        </div>

        <!-- Quick Actions -->
        <a class="btn-secondary topbar-quick-action is-low-priority" href="${pageContext.request.contextPath}/admin/orders" title="Check-in vé">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px;"><path d="M3 8h18v3a2 2 0 0 0 0 4v3H3v-3a2 2 0 0 0 0-4zM9 8v12"/></svg>
            <span>Check-in vé</span>
        </a>

        <a class="btn-secondary topbar-quick-action is-low-priority" href="${pageContext.request.contextPath}/admin/comments" title="Duyệt bình luận">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px;"><path d="M4 5h16v11H9l-5 4z"/></svg>
            <span>Duyệt bình luận</span>
        </a>

        <a class="btn-secondary topbar-quick-action" href="${pageContext.request.contextPath}/admin/showtimes" title="Tạo suất chiếu">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px;"><path d="M12 5v14M5 12h14"/></svg>
            <span>Tạo suất chiếu</span>
        </a>

        <div style="position:relative; display:inline-block;">
            <button type="button" id="topbarNotificationBtn" data-context-path="${pageContext.request.contextPath}" onclick="toggleAdminNotificationDropdown(event)" class="topbar-notif-btn" title="Trung tâm thông báo">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                </svg>
                <c:set var="totalAdminNotif" value="${(not empty sessionScope.currentUser and not sessionScope.currentUser.emailVerified ? 1 : 0) + (not empty unreadNotificationCount ? unreadNotificationCount : 0)}" />
                <span id="topbarNotificationBadge" class="topbar-notif-badge" style="${totalAdminNotif > 0 ? '' : 'display:none;'}">${totalAdminNotif}</span>
            </button>

            <!-- ADMIN NOTIFICATION DROPDOWN POPUP -->
            <div id="adminNotificationDropdown" style="display:none; position:absolute; top:calc(100% + 8px); right:0; width:340px; background:#ffffff; border-radius:14px; box-shadow:0 20px 25px -5px rgba(0,0,0,0.15), 0 10px 10px -5px rgba(0,0,0,0.04); border:1px solid #e2e8f0; z-index:99999; color:#0f172a; text-align:left; overflow:hidden;">
                <div style="padding:12px 16px; background:#f8fafc; border-bottom:1px solid #e2e8f0; display:flex; align-items:center; justify-content:space-between;">
                    <strong style="font-size:14px; color:#0f172a; font-weight:700;">🔔 Thông báo hệ thống</strong>
                    <a href="${pageContext.request.contextPath}/admin/notifications" style="font-size:12px; color:#ea580c; text-decoration:none; font-weight:600;">Xem tất cả →</a>
                </div>
                <div style="max-height:360px; overflow-y:auto; padding:12px;">
                    <c:if test="${not empty sessionScope.currentUser and not sessionScope.currentUser.emailVerified}">
                        <div style="background:#fffbeb; border:1px solid #fde68a; border-radius:10px; padding:12px; margin-bottom:8px;">
                            <div style="display:flex; align-items:flex-start; gap:10px;">
                                <span style="font-size:18px;">✉️</span>
                                <div style="flex:1;">
                                    <strong style="font-size:13px; color:#92400e; display:block; margin-bottom:4px; font-weight:700;">Xác thực Email Quản trị</strong>
                                    <p style="font-size:12px; color:#b45309; margin:0 0 8px 0; line-height:1.4;">Email tài khoản của bạn chưa được xác thực. Bạn nên xác thực để bảo mật tài khoản Admin.</p>
                                    <form method="post" action="${pageContext.request.contextPath}/resend-verification" style="margin:0;">
                                        <%@ include file="/WEB-INF/views/shared/csrf.jspf" %>
                                        <button type="submit" style="padding:4px 10px; font-size:11px; font-weight:700; background:#ea580c; color:#ffffff; border:none; border-radius:6px; cursor:pointer;">
                                            Xác thực ngay
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </c:if>
                    <c:if test="${empty sessionScope.currentUser or sessionScope.currentUser.emailVerified}">
                        <div style="text-align:center; padding:20px 12px; color:#94a3b8;">
                            <div style="font-size:24px; margin-bottom:4px;">🎉</div>
                            <p style="font-size:12px; margin:0;">Không có thông báo mới nào</p>
                        </div>
                    </c:if>
                </div>
            </div>
        </div>
    </div>
</header>

<div id="adminToastContainer" class="admin-toast-container" aria-live="polite" aria-atomic="true"></div>

<script src="${pageContext.request.contextPath}/assets/js/admin-ui.js?v=20260806" defer></script>
<script>
    function toggleAdminNotificationDropdown(e) {
        if (e) e.stopPropagation();
        var dropdown = document.getElementById('adminNotificationDropdown');
        if (dropdown) {
            var isVisible = dropdown.style.display === 'block';
            dropdown.style.display = isVisible ? 'none' : 'block';
        }
    }
    document.addEventListener('click', function(e) {
        var dropdown = document.getElementById('adminNotificationDropdown');
        var btn = document.getElementById('topbarNotificationBtn');
        if (dropdown && dropdown.style.display === 'block') {
            if (!dropdown.contains(e.target) && (!btn || !btn.contains(e.target))) {
                dropdown.style.display = 'none';
            }
        }
    });

    var adminConfirmCallback = null;

    function showAdminConfirm(options) {
        var modal = document.getElementById('adminConfirmModal');
        var titleEl = document.getElementById('adminConfirmTitle');
        var descEl = document.getElementById('adminConfirmMessage');
        var subnoteEl = document.getElementById('adminConfirmSubnote');
        var okBtn = document.getElementById('adminConfirmOkBtn');
        var cancelBtn = document.getElementById('adminConfirmCancelBtn');

        if (!modal) return;

        titleEl.textContent = options.title || 'Xác nhận thao tác';
        descEl.textContent = options.message || 'Bạn có chắc chắn muốn thực hiện thao tác này không?';

        if (options.subnote) {
            subnoteEl.textContent = options.subnote;
            subnoteEl.style.display = 'block';
        } else {
            subnoteEl.style.display = 'none';
        }

        okBtn.textContent = options.confirmText || 'Xác nhận';
        cancelBtn.textContent = options.cancelText || 'Hủy bỏ';

        if (options.isDanger !== false) {
            okBtn.className = 'admin-modal-btn confirm danger';
        } else {
            okBtn.className = 'admin-modal-btn confirm';
        }

        adminConfirmCallback = options.onConfirm || null;

        modal.style.display = 'flex';
        requestAnimationFrame(function() {
            modal.classList.add('is-active');
        });
    }

    function closeAdminConfirm(result) {
        var modal = document.getElementById('adminConfirmModal');
        if (!modal) return;

        modal.classList.remove('is-active');
        setTimeout(function() {
            modal.style.display = 'none';
            if (result && typeof adminConfirmCallback === 'function') {
                adminConfirmCallback();
            }
            adminConfirmCallback = null;
        }, 200);
    }
</script>

<!-- SLEEK MINIMALIST CUSTOM CONFIRM MODAL FOR ADMIN -->
<div id="adminConfirmModal" class="admin-modal-backdrop" style="display: none;" onclick="if(event.target===this) closeAdminConfirm(false);">
    <div class="admin-modal-box">
        <div class="admin-modal-icon-wrap">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 1-1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                <line x1="12" y1="9" x2="12" y2="13"/>
                <line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
        </div>
        <h3 id="adminConfirmTitle" class="admin-modal-title">Xác nhận thao tác</h3>
        <p id="adminConfirmMessage" class="admin-modal-desc">Bạn có chắc chắn muốn thực hiện thao tác này không?</p>
        <p id="adminConfirmSubnote" class="admin-modal-subnote" style="display:none;"></p>
        <div class="admin-modal-actions">
            <button type="button" id="adminConfirmCancelBtn" class="admin-modal-btn cancel" onclick="closeAdminConfirm(false)">Hủy bỏ</button>
            <button type="button" id="adminConfirmOkBtn" class="admin-modal-btn confirm danger" onclick="closeAdminConfirm(true)">Xác nhận</button>
        </div>
    </div>
</div>
