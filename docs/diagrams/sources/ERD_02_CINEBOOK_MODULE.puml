@startuml ERD_02_DonHangComboHoaDon
title ERD CineBookDB (2/4) — Đơn hàng · Ghế đặt · Combo · Hoá đơn
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam linetype ortho

entity "Users" as Users {
  * Id : INT <<PK>>
}

entity "Showtimes" as Showtimes {
  * Id : INT <<PK>>
}

entity "ShowtimeSeats" as ShowtimeSeats {
  * Id : INT <<PK>>
}

entity "Cinemas" as Cinemas {
  * Id : INT <<PK>>
}

entity "Promotions" as Promotions {
  * Id : INT <<PK>>
}

entity "Orders" as Orders {
  * Id : INT <<PK>>
  --
  UserId : INT <<FK>>
  ShowtimeId : INT <<FK>>
  PromotionId : INT <<FK>>
  TicketCode : NVARCHAR(32) <<UQ>>
  PaymentMethod : NVARCHAR(50)
  PaymentStatus : NVARCHAR(20) = 'pending'
  OrderStatus : NVARCHAR(20) = 'pending'
  IdempotencyKey : NVARCHAR(100) <<UQ>>
  CounterExpiresAt : DATETIME
  CheckinStatus : NVARCHAR(30) = 'not_checked_in'
  CheckinByStaffId : INT <<FK>>
  RefundedBy : INT <<FK*>>
  RefundRejectedBy : INT <<FK*>>
  TotalAmount : DECIMAL(19,2)
  IsUserHidden : BIT = 0 <color:blue>[fix39]</color>
  StateVersion : ROWVERSION
  ' CHECK PaymentStatus IN ('pending','paid','failed','cancelled','refunded') [fix02]
  ' CHECK OrderStatus IN ('created','pending','confirmed','cancelled','completed','redeemed') [fix22]
  ' CHECK CheckinStatus IN ('not_checked_in','checked_in') [fix00]
}

entity "OrderSeats" as OrderSeats {
  * OrderId : INT <<PK,FK>>
  * ShowtimeSeatId : INT <<PK,FK>>
  --
  SeatKey : NVARCHAR(20)
  UnitPrice : DECIMAL(19,2)
  ' KHÔNG có cột Id — khoá kép thật
}

entity "ComboFoods" as ComboFoods {
  * Id : INT <<PK>>
  --
  Name : NVARCHAR(150)
