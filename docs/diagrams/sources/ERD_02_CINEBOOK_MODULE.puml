  --
  SourceType : NVARCHAR(20)
  NotificationId : INT <<FK*>>
  ' polymorphic: trỏ UserNotifications.Id hoặc AdminNotifications.Id
  ' tuỳ SourceType — cố ý KHÔNG khai FK
  UserId : INT <<FK>>
  ' UNIQUE (SourceType, NotificationId, UserId)
}

entity "AuditLogs" as AuditLogs {
  * Id : INT <<PK>>
  --
  ActorUserId : INT <<FK>>
  Action : NVARCHAR(100)
  DetailJson : NVARCHAR(MAX)
}

entity "SystemSettings" as SystemSettings {
  * SettingKey : NVARCHAR(100) <<PK>>
  --
  SettingValue : NVARCHAR(MAX)
  ' [fix38] seed thêm khoá 'refund.appealWindowHours' = '24' nếu chưa có
}

entity "PolicyDocuments" as PolicyDocuments {
  * Id : INT <<PK>>
  --
  PolicyKey : NVARCHAR(80)
  VersionNumber : INT
  Status : NVARCHAR(20)
  UpdatedBy : INT <<FK>>
  ' UNIQUE (PolicyKey, VersionNumber)
}

entity "BookingCommandExecutions" as BookingCommandExecutions {
  * Id : BIGINT <<PK>>
  --
  OrderId : INT <<FK>>
  IdempotencyKey : NVARCHAR(150)
  Status : NVARCHAR(20) = 'succeeded'
  ' UNIQUE (ActorScope, CommandType, IdempotencyKey)
  ' CHECK Status IN ('processing','succeeded','failed')
}

entity "BookingStateTransitions" as BookingStateTransitions {
  * Id : BIGINT <<PK>>
  --
  OrderId : INT <<FK>>
  CommandExecutionId : BIGINT <<FK>>
  BeforeState : NVARCHAR(40)
  AfterState : NVARCHAR(40)
}

entity "BookingOutbox" as BookingOutbox {
  * Id : BIGINT <<PK>>
  --
  AggregateType : NVARCHAR(40)
  AggregateId : INT
  ' tham chiếu mềm đa hình theo AggregateType — không FK
  DedupeKey : NVARCHAR(220) <<UQ>>
  Status : NVARCHAR(20) = 'pending'
  ' CHECK Status IN ('pending','processing','completed','failed')
}

Users ||--o{ Comments : "UserId → Id"
Films ||--o{ Comments : "FilmId → Id"
Comments ||--o{ CommentReports : "CommentId → Id"
Users |o..o{ CommentReports : "ReporterUserId → Id"
Users ||--o{ AdminNotifications : "ResolvedBy → Id"
Cinemas ..> UserNotifications : "CinemaId → Id"
Users ||--o{ UserNotifications : "CreatedByUserId → Id"
Users ||--o{ NotificationRecipients : "UserId → Id"
Users |o..o{ AuditLogs : "ActorUserId → Id"
Users ||--o{ PolicyDocuments : "UpdatedBy → Id"
Orders ||--o{ BookingCommandExecutions : "OrderId → Id"
Orders ||--o{ BookingStateTransitions : "OrderId → Id"
BookingCommandExecutions ||--o{ BookingStateTransitions : "CommandExecutionId → Id"
@enduml
