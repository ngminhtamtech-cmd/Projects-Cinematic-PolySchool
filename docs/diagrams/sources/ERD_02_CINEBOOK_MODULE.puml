Users ||--o{ PromotionUsage : "UserId → Id"
Orders ||--o{ PromotionUsage : "OrderId → Id"
Users ||--o{ PointTransactions : "UserId → Id"
Users ||--o{ LoyaltyPointDebtLedger : "UserId → Id"
