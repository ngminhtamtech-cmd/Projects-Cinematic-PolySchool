' =============================================================================
'  CineBook — ERD (Entity Relationship Diagram) đầy đủ CineBookDB — bản cập nhật
'  Nguồn gốc: back-up/back-up/ERD_CINEBOOK.puml (dựng từ database/schema.sql +
'  toàn bộ script migration alter_*, migration_*, fix00–fix33, đọc theo đúng thứ
'  tự trong scripts/init-test-db.ps1). Bản này bổ sung DELTA đã kiểm chứng từ
'  fix34_admin_domain_integrity.sql và fix35_film_showtime_lifecycle.sql (5 script
'  fix36–fix38 tiếp theo chỉ SIẾT ràng buộc dữ liệu UserAppeals/SystemSettings,
'  KHÔNG thêm bảng/cột mới — đã kiểm tra, không có delta cấu trúc).
'
'  Khảo sát thực tế: quét "CREATE TABLE" trên toàn bộ 61 file trong database/ ra
'  đúng 38 bảng, khớp 1-1 với danh sách entity bên dưới — không thiếu, không thừa.
'
'  DELTA fix34 (đã xác minh trong file, không suy đoán):
'   · Cinemas.CinemaType NVARCHAR(20) NOT NULL DEFAULT 'STANDARD'
'       CHECK (CinemaType IN ('STANDARD','VIP'))
'   · Rooms.RoomType NVARCHAR(20) NOT NULL DEFAULT 'STANDARD'
'       CHECK (RoomType IN ('STANDARD','VIP'))
'   · Rooms.Status: đã tồn tại từ alter_rooms_status.sql (không đổi ở fix34,
'       fix34 chỉ thêm CHECK (Status IN ('active','inactive')) nếu thiếu)
'
'  DELTA fix35 (đã xác minh trong file, không suy đoán):
'   · Films.DeletedAt DATETIME2(7) NULL
'   · Films.DeletedByUserId INT NULL  →  FK_Films_DeletedByUser → Users(Id)  [MỚI]
'   · Films.DeletionMode NVARCHAR(30) NULL  CHECK (PURGE_COMMENTS/PRESERVE_COMMENTS
'       khi DeletedAt NOT NULL)
'   · Showtimes.SaleStatus NVARCHAR(20) NOT NULL DEFAULT 'ON_SALE'
'       CHECK (ON_SALE/SUSPENDED/DELETED)
'   · Showtimes.DeleteRequestedAt DATETIME2(7) NULL
'   · Showtimes.DeleteNotBefore DATETIME2(7) NULL  (hàng rào xoá 2 pha)
'   · Showtimes.DeleteRequestedByUserId INT NULL  →
'       FK_Showtimes_DeleteRequestedByUser → Users(Id)  [MỚI]
'
'  QUY ƯỚC:
'   · <<PK>> = khoá chính, <<FK>> = khoá ngoại có ràng buộc FOREIGN KEY thật
'     trong DB. <<FK*>> = liên kết nghiệp vụ nhưng KHÔNG có FOREIGN KEY constraint
'     thực thi (tham chiếu mềm cố ý, ví dụ PointTransactions.OrderId) — ghi rõ
'     để không đọc nhầm là ràng buộc cứng.
'   · OrderSeats, OrderComboFoods, FilmCategories, CinemaFilms dùng KHOÁ KÉP
'     (composite PK), KHÔNG có cột Id riêng — đúng theo schema.sql thật.
'   · Cột được đánh dấu [fix34]/[fix35] là cột mới so với bản ERD gốc (fix33).
'
'  Render: java -jar tools/plantuml.jar -tsvg -charset UTF-8 ERD_02_CINEBOOK_MODULE.puml
'          java -jar tools/plantuml.jar -tpng -charset UTF-8 ERD_02_CINEBOOK_MODULE.puml
' =============================================================================


' ╔═══════════════════════════════════════════════════════════════════════════╗
' ║  ERD 1 — LÕI: NGƯỜI DÙNG · RẠP · PHIM · SUẤT CHIẾU · GHẾ (đã vá fix34/fix35) ║
' ╚═══════════════════════════════════════════════════════════════════════════╝
@startuml ERD_01_LoiRapPhimSuatChieu
title ERD CineBookDB (1/4) — Người dùng · Rạp · Phim · Suất chiếu · Ghế\n<size:11>(cập nhật delta fix34 + fix35 — xem ghi chú đầu file)</size>
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam linetype ortho

entity "Cities" as Cities {
  * Id : INT <<PK>>
  --
  Name : NVARCHAR(100)
}

entity "Cinemas" as Cinemas {
  * Id : INT <<PK>>
  --
  CityId : INT <<FK>>
  Name : NVARCHAR(150)
  Address : NVARCHAR(255)
  Status : NVARCHAR(20) = 'active'
  BannerUrl : NVARCHAR(500)
  CinemaType : NVARCHAR(20) = 'STANDARD' <color:blue>[fix34]</color>
  ' CHECK CinemaType IN ('STANDARD','VIP')
}

entity "Users" as Users {
  * Id : INT <<PK>>
  --
  Email : NVARCHAR(100) <<UQ>>
  PasswordHash : NVARCHAR(255)
  Role : NVARCHAR(20) = 'member'
  CinemaId : INT <<FK>>
  IsLocked : BIT
  LoyaltyPoints : INT
  MembershipTier : NVARCHAR(20) = 'BRONZE'
  LoyaltyPointDebt : INT
  Deleted : BIT
}

entity "Rooms" as Rooms {
  * Id : INT <<PK>>
  --
  CinemaId : INT <<FK>>
  Name : NVARCHAR(100)
  Status : NVARCHAR(20) = 'active' <color:blue>[fix40]</color>
  RoomType : NVARCHAR(20) = 'STANDARD' <color:blue>[fix34]</color>
  ' CHECK RoomType IN ('STANDARD','VIP')
  ' CHECK Status IN ('active','inactive','deleted') [fix40]
}

entity "Seats" as Seats {
  * Id : INT <<PK>>
  --
  RoomId : INT <<FK>>
  RowLabel : NVARCHAR(10)
  SeatNumber : INT
  SeatType : NVARCHAR(20)
  SeatKey : NVARCHAR(20)
  IsActive : BIT
  PriceSurcharge : DECIMAL(19,2)
  ' UNIQUE lọc (RoomId, SeatKey) WHERE IsActive=1
}

entity "Films" as Films {
  * Id : INT <<PK>>
  --
  Title : NVARCHAR(255)
  ReleaseDate : DATE
  EndDate : DATE
  Status : NVARCHAR(20) = 'showing'
  Format : NVARCHAR(50)
  DeletedAt : DATETIME2(7) <color:blue>[fix35]</color>
  DeletedByUserId : INT <<FK>> <color:blue>[fix35]</color>
  DeletionMode : NVARCHAR(30) <color:blue>[fix35]</color>
  ' CHECK: DeletedAt+DeletionMode cùng NULL hoặc cùng có giá trị
  ' DeletionMode IN ('PURGE_COMMENTS','PRESERVE_COMMENTS')
}

entity "Categories" as Categories {
  * Id : INT <<PK>>
  --
  Title : NVARCHAR(100)
}

entity "FilmCategories" as FilmCategories {
  * FilmId : INT <<PK,FK>>
  * CategoryId : INT <<PK,FK>>
}

entity "CinemaFilms" as CinemaFilms {
  * CinemaId : INT <<PK,FK>>
  * FilmId : INT <<PK,FK>>
}

entity "Showtimes" as Showtimes {
  * Id : INT <<PK>>
  --
  FilmId : INT <<FK>>
  CinemaId : INT <<FK>>
  RoomId : INT <<FK>>
  StartTime : DATETIME
  EndTime : DATETIME
  BasePrice : DECIMAL(19,2)
  Format : NVARCHAR(50) = '2D'
  SaleStatus : NVARCHAR(20) = 'ON_SALE' <color:blue>[fix35]</color>
  DeleteRequestedAt : DATETIME2(7) <color:blue>[fix35]</color>
  DeleteNotBefore : DATETIME2(7) <color:blue>[fix35]</color>
  DeleteRequestedByUserId : INT <<FK>> <color:blue>[fix35]</color>
  ' CHECK SaleStatus IN ('ON_SALE','SUSPENDED','DELETED');
  ' xoá 2 pha: SUSPENDED/DELETED bắt buộc có DeleteRequestedAt+DeleteNotBefore
}

entity "ShowtimeSeats" as ShowtimeSeats {
  * Id : INT <<PK>>
  --
  ShowtimeId : INT <<FK>>
  SeatId : INT <<FK>>
  Status : NVARCHAR(20) = 'available'
  HeldByUserId : INT <<FK>>
  HeldUntil : DATETIME
  ClaimedByOrderId : INT <<FK>>
  ' CHECK Status IN ('available','held','booked','maintenance') [alter_seats_add_maintenance]
  ' UNIQUE (ShowtimeId, SeatId)
}

Cities ||--o{ Cinemas : "CityId → Id"
Cinemas ||--o{ Users : "CinemaId → Id (staff/manager)"
Cinemas ||--o{ Rooms : "CinemaId → Id"
Rooms ||--o{ Seats : "RoomId → Id"
Films ||--o{ FilmCategories : "FilmId → Id"
Categories ||--o{ FilmCategories : "CategoryId → Id"
Cinemas ||--o{ CinemaFilms : "CinemaId → Id"
Films ||--o{ CinemaFilms : "FilmId → Id"
Films ||--o{ Showtimes : "FilmId → Id"
Cinemas ||--o{ Showtimes : "CinemaId → Id"
Rooms ||--o{ Showtimes : "RoomId → Id"
Showtimes ||--o{ ShowtimeSeats : "ShowtimeId → Id"
Seats ||--o{ ShowtimeSeats : "SeatId → Id"
Users ||--o{ ShowtimeSeats : "HeldByUserId → Id"
Users |o..o{ Films : "DeletedByUserId → Id"
Users |o..o{ Showtimes : "DeleteRequestedByUserId → Id"
@enduml


